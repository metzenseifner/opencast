<?xml version="1.0" encoding="UTF-8"?>
<scr:component xmlns:scr="http://www.osgi.org/xmlns/scr/v1.1.0"
               name="org.opencastproject.mergemediapackages.impl.Cronjob"
               immediate="true"  activate="activate"
               deactivate="deactivate">
  <implementation class="org.opencastproject.mergemediapackages.impl.Cronjob"/>
  <reference name="assetManager" interface="org.opencastproject.assetmanager.api.AssetManager"
             bind="setAssetManager"/>
  <reference name="SecurityService"
             interface="org.opencastproject.security.api.SecurityService"
             bind="setSecurityService"/>
  <reference name="AdminUISearchIndex"
             interface="org.opencastproject.adminui.index.AdminUISearchIndex"
             bind="setAdminUISearchIndex"/>
  <reference name="workspace"
             interface="org.opencastproject.workspace.api.Workspace"
             bind="setWorkspace"/>
</scr:component>
